# 环境变量清单（本项目读取的是系统环境变量，不会自动加载 .env 文件）
# 用法示例：
#   Windows PowerShell:  $env:DEEPSEEK_API_KEY = "sk-..."
#   macOS / Linux:       export DEEPSEEK_API_KEY="sk-..."
# 也可以用 `python set_api_key.py <name> <key>` 存进系统 keyring。

# --- LLM（至少配一个；DeepSeek 为主，MiniMax 为备）---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=abab6.5s-chat

# --- 数据源（OpenAlex 无 key 也能用；S2 建议配 key）---
OPENALEX_API_KEY=
S2_API_KEY=

# 默认数据源：openalex 或 s2
DATASOURCE=openalex

# --- 其他 ---
# 明文 key 文件目录（默认 ~/.academic-social-map/keys）
KEYS_DIR=
# 填了会作为 mailto 放进 User-Agent，OpenAlex 会给更宽松的限流
OPENALEX_MAILTO=
